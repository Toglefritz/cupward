  "brewPhasePour": "Pour {number}",
  "@brewPhasePour": {
    "description": "Name of one of a recipe's pours, numbered in order, shown in the phase indicator, such as \"Pour 2\"",
    "placeholders": {
      "number": {
        "type": "int",
        "description": "The position of the pour among the recipe's pours, starting at 1"
      }
    }
  },
  "brewPhaseComplete": "Complete",
  "@brewPhaseComplete": {
    "description": "Name of the final phase of a brew, shown in the phase indicator"
  },
  "brewPhaseProgress": "Step {current} of {total}, {phase}",

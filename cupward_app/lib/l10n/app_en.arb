    "description": "Small, spaced capital label above the current step's title on the brewing screen, such as \"STEP 1 OF 6\". Written in capitals here because the design shows it that way.",
    "placeholders": {
      "current": {
        "type": "int",
        "description": "The position of the current step, starting at 1"
      },
      "total": {
        "type": "int",
        "description": "The number of steps in the brew"
      }
    }
  },

{
  "appTitle": "Cupward",
  "@appTitle": {
    "description": "The title of the application, also shown as the large title on the home screen"
  },
  "buttonStartBrew": "Start a Brew",
  "@buttonStartBrew": {
    "description": "Label for the primary button at the bottom of the home screen that starts a new brewing session"
  },
  "recipeCoffeeLabel": "Coffee",
  "@recipeCoffeeLabel": {
    "description": "Caption under the coffee dose in the recipe summary card, such as under \"20.0 g\""
  },
  "recipeWaterLabel": "Water",
  "@recipeWaterLabel": {
    "description": "Caption under the water weight in the recipe summary card"
  },
  "recipeBrewTimeLabel": "Time",
  "@recipeBrewTimeLabel": {
    "description": "Caption under the target brew time in the recipe summary card, such as under \"3:00\""
  },
  "recipeYieldLabel": "Yield",
  "@recipeYieldLabel": {
    "description": "Caption under the approximate amount of coffee the recipe makes in the recipe summary card"
  },
  "recipeGrams": "{grams} g",
  "@recipeGrams": {
    "description": "A weight in grams in the recipe summary card, such as \"20.0 g\". The number is already formatted for the locale.",
    "placeholders": {
      "grams": {
        "type": "String",
        "description": "The formatted number of grams"
      }
    }
  },
  "recipeYieldMilliliters": "~{milliliters} ml",
  "@recipeYieldMilliliters": {
    "description": "The approximate amount of coffee a recipe makes, in milliliters, such as \"~320 ml\". The tilde marks it as an estimate.",
    "placeholders": {
      "milliliters": {
        "type": "String",
        "description": "The formatted number of milliliters"
      }
    }
  },
  "brewPhasePrepare": "Prepare",
  "@brewPhasePrepare": {
    "description": "Name of the phase of a brew in which the user sets up and tares the scale, shown in the phase indicator"
  },
  "brewPhaseBloom": "Bloom",
  "@brewPhaseBloom": {
    "description": "Name of the first, small pour that wets the coffee grounds, shown in the phase indicator"
  },
  "brewPhasePour": "Pour {number}",
  "@brewPhasePour": {
    "description": "Name of one of a recipe's pours, numbered in order, shown in the phase indicator, such as \"Pour 2\"",
    "placeholders": {
      "number": {
        "type": "int",
        "description": "The position of the pour among the recipe's pours, starting at 1"
      }
    }
  },
  "brewPhaseComplete": "Complete",
  "@brewPhaseComplete": {
    "description": "Name of the final phase of a brew, shown in the phase indicator"
  },
  "brewPhaseProgress": "Step {current} of {total}, {phase}",
  "@brewPhaseProgress": {
    "description": "What screen readers announce for the phase indicator, such as \"Step 2 of 6, Bloom\"",
    "placeholders": {
      "current": {
        "type": "int",
        "description": "The position of the current phase, starting at 1"
      },
      "total": {
        "type": "int",
        "description": "The number of phases in the brew"
      },
      "phase": {
        "type": "String",
        "description": "The name of the current phase"
      }
    }
  },
  "brewStepCount": "STEP {current} OF {total}",
  "@brewStepCount": {
    "description": "Small, spaced capital label above the current step's title on the brewing screen, such as \"STEP 1 OF 6\". Written in capitals here because the design shows it that way.",
    "placeholders": {
      "current": {
        "type": "int",
        "description": "The position of the current step, starting at 1"
      },
      "total": {
        "type": "int",
        "description": "The number of steps in the brew"
      }
    }
  },
  "brewStepTitlePrepare": "Prepare to Brew",
  "@brewStepTitlePrepare": {
    "description": "Large title of the setup step of a brew"
  },
  "brewStepTitleBloom": "Bloom",
  "@brewStepTitleBloom": {
    "description": "Large title of the bloom step, the first small pour that wets the coffee grounds"
  },
  "brewStepTitlePour": "Pour {number}",
  "@brewStepTitlePour": {
    "description": "Large title of one of a recipe's pours, numbered in order, such as \"Pour 2\"",
    "placeholders": {
      "number": {
        "type": "int",
        "description": "The position of the pour among the recipe's pours, starting at 1"
      }
    }
  },
  "brewStepTitleComplete": "Enjoy Your Coffee",
  "@brewStepTitleComplete": {
    "description": "Large title of the final step of a brew, after the water has drained through"
  },
  "brewStepInstructionsPrepare": "Set up your brewer, place it on the scale, and tare.",
  "@brewStepInstructionsPrepare": {
    "description": "Short reminder under the title of the setup step. Kept brief because the user is brewing and has done it before."
  },
  "brewStepInstructionsBloom": "Wet all the grounds with a little water, then let them rest.",
  "@brewStepInstructionsBloom": {
    "description": "Short reminder under the title of the bloom step"
  },
  "brewStepInstructionsPour": "Pour slowly and evenly to the next target.",
  "@brewStepInstructionsPour": {
    "description": "Short reminder under the title of each pour step"
  },
  "brewStepInstructionsComplete": "Let it finish draining, then swirl and serve.",
  "@brewStepInstructionsComplete": {
    "description": "Short reminder under the title of the final step of a brew"
  },
  "brewStepTarget": "Target {weight} g",
  "@brewStepTarget": {
    "description": "Line under the instructions of a step that has a weight target, such as \"Target 160 g\". The weight is the total on the scale, counting all the water poured so far.",
    "placeholders": {
      "weight": { "type": "String", "description": "The target weight in grams, without a unit, such as \"160\" or \"62.5\"" }
    }
  },
  "brewActionContinue": "Continue",
  "@brewActionContinue": {
    "description": "Label of the main button at the bottom of the brewing screen during the setup step. Tapping it tares the scale and starts the brew."
  },
  "brewActionNextStep": "Next step",
  "@brewActionNextStep": {
    "description": "Label of the main button at the bottom of the brewing screen during the bloom and pours. Tapping it moves to the next step."
  },
  "brewActionDone": "Done",
  "@brewActionDone": {
    "description": "Label of the main button at the bottom of the brewing screen during the final step. Tapping it leaves the brewing screen."
  },
  "brewAdvanceCountdown": "Next step in {seconds}",
  "@brewAdvanceCountdown": {
    "description": "Message above the main button while the brew is about to move to the next step by itself, such as \"Next step in 3\". The user can cancel until it reaches zero.",
    "placeholders": {
      "seconds": { "type": "int", "description": "Whole seconds left before the brew moves on" }
    }
  },
  "brewAdvanceCancel": "Cancel",
  "@brewAdvanceCancel": {
    "description": "Label of the button next to the countdown that stops the brew from moving to the next step by itself"
  },
  "brewRestRemaining": "Rest {time}",
  "@brewRestRemaining": {
    "description": "Message above the main button while the grounds rest after the bloom water is added, such as \"Rest 0:32\"",
    "placeholders": {
      "time": { "type": "String", "description": "The time left in the rest, as minutes and seconds" }
    }
  },
  "scaleTitle": "Scale",
  "@scaleTitle": {
    "description": "Heading of the scale panel on the brewing screen"
  },
  "scaleStatusConnected": "Connected",
  "@scaleStatusConnected": {
    "description": "Status in the scale panel while a scale is connected"
  },
  "scaleStatusDisconnected": "Not connected",
  "@scaleStatusDisconnected": {
    "description": "Status in the scale panel while no scale is connected"
  },
  "scaleStatusScanning": "Searching",
  "@scaleStatusScanning": {
    "description": "Status in the scale panel while the app looks for nearby scales"
  },
  "scaleStatusConnecting": "Connecting",
  "@scaleStatusConnecting": {
    "description": "Status in the scale panel while the app connects to the chosen scale"
  },
  "scaleStatusUnsupported": "Not available",
  "@scaleStatusUnsupported": {
    "description": "Status in the scale panel on platforms that cannot use Bluetooth scales, such as a web browser"
  },
  "scaleBattery": "{percent}%",
  "@scaleBattery": {
    "description": "The scale's remaining battery charge, shown beside a battery icon, such as \"82%\"",
    "placeholders": {
      "percent": {
        "type": "int",
        "description": "The charge from 0 to 100"
      }
    }
  },
  "scaleBatterySemantics": "Scale battery {percent} percent",
  "@scaleBatterySemantics": {
    "description": "What screen readers announce for the scale's battery level",
    "placeholders": {
      "percent": {
        "type": "int",
        "description": "The charge from 0 to 100"
      }
    }
  },
  "scaleGrams": "{grams} g",
  "@scaleGrams": {
    "description": "The scale's live weight, such as \"0.0 g\". The number is already formatted.",
    "placeholders": {
      "grams": {
        "type": "String",
        "description": "The formatted weight"
      }
    }
  },
  "scaleFlowRate": "{rate} g/s",
  "@scaleFlowRate": {
    "description": "The rate at which water is being poured, in grams per second, such as \"3.2 g/s\"",
    "placeholders": {
      "rate": {
        "type": "String",
        "description": "The formatted rate"
      }
    }
  },
  "scaleFlowLabel": "Flow",
  "@scaleFlowLabel": {
    "description": "Caption under the pour rate in the scale panel"
  },
  "scaleNoReading": "–",
  "@scaleNoReading": {
    "description": "Placeholder for a scale value when no scale is connected or no reading has arrived"
  },
  "buttonTare": "Tare",
  "@buttonTare": {
    "description": "Label of the button that zeroes the scale, shown in the scale panel during setup"
  },
  "buttonFindScale": "Find scale",
  "@buttonFindScale": {
    "description": "Label of the button in the scale panel that starts looking for nearby BOOKOO scales"
  },
  "scalePickerTitle": "Choose your scale",
  "@scalePickerTitle": {
    "description": "Title of the sheet that lists nearby BOOKOO scales"
  },
  "scalePickerSearching": "Looking for BOOKOO scales. Make sure yours is on and nearby.",
  "@scalePickerSearching": {
    "description": "Shown in the scale sheet while searching and nothing has been found yet"
  },
  "scalePickerNoneFound": "No scales found. Wake your scale, then search again.",
  "@scalePickerNoneFound": {
    "description": "Shown in the scale sheet when a search ended without finding a scale"
  },
  "scalePickerSignal": "Signal {rssi} dBm",
  "@scalePickerSignal": {
    "description": "Signal strength of a nearby scale in the scale sheet, such as \"Signal -58 dBm\"",
    "placeholders": {
      "rssi": {
        "type": "int",
        "description": "The received signal strength in dBm, a negative number"
      }
    }
  },
  "buttonSearchAgain": "Search again",
  "@buttonSearchAgain": {
    "description": "Button in the scale sheet that restarts the search for scales"
  },
  "scaleFailureBluetooth": "Turn on Bluetooth and allow Cupward to use it, then try again.",
  "@scaleFailureBluetooth": {
    "description": "Shown when the scale search failed because Bluetooth is off or not permitted"
  },
  "scaleFailureConnection": "Couldn't connect to the scale. Make sure it's on and nearby.",
  "@scaleFailureConnection": {
    "description": "Shown when connecting to the chosen scale failed"
  },
  "scaleFailureUnsupported": "That device isn't a supported scale.",
  "@scaleFailureUnsupported": {
    "description": "Shown when the chosen device connected but is not a supported BOOKOO scale"
  },
  "scaleFailureUnknown": "Something went wrong with the scale. Try again.",
  "@scaleFailureUnknown": {
    "description": "Shown for any other scale failure"
  },
  "scaleTareFailed": "Couldn't tare the scale.",
  "@scaleTareFailed": {
    "description": "Shown briefly when the tare command could not be sent"
  }
}
